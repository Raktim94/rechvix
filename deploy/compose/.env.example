# Copy this file to .env in this same directory before running
# `docker compose up`. Never commit a real .env — it's already covered by
# the repo's root .gitignore.

# --- required ---

# Two real, different Postgres passwords. Generate each with, e.g.:
#   openssl rand -hex 24
# Use hex, not base64 — these get spliced unescaped into postgres:// URLs
# in docker-compose.yml, and base64's alphabet includes '/', which a URL
# parser reads as ending the userinfo section. A password containing one
# silently breaks the DSN and migrate/app/worker all fail to connect.
# POSTGRES_PASSWORD is for billing_migrator, the schema-owning role that
# runs migrations. BILLING_APP_PASSWORD is for billing_app, the separate,
# non-owning role apps/server and apps/worker actually connect as at
# runtime — required for Row-Level Security tenant isolation to actually
# apply (see migrations/0001_organisation_hierarchy.up.sql). Don't reuse
# the same password for both.
POSTGRES_PASSWORD=
BILLING_APP_PASSWORD=

# Backup & restore (Settings → Backup) is enabled automatically using
# POSTGRES_PASSWORD above — no separate secret to set. docker-compose.yml
# builds BACKUP_DATABASE_DSN from it directly.

# Encrypts integration credentials at rest (e-Invoice/e-Way Bill provider
# secrets, etc. — internal/platform/crypto). Generate one:
#   openssl rand -base64 32
# Losing this key means those encrypted values become unrecoverable —
# back it up somewhere safe, separate from the database backup.
AEAD_ENCRYPTION_KEY=

# --- optional (sensible defaults if left unset) ---

# Port the API listens on, on the host.
HTTP_PORT=8080

# Set to true only once you're serving over real HTTPS (directly, via the
# optional reverse-proxy profile, or behind CasaOS's/your own existing
# proxy) — see docs/operations/deployment.md. Leave false for local/LAN
# plain-HTTP use, same reasoning nodedr-pos's COOKIE_SECURE flag uses.
SESSION_COOKIE_SECURE=false

# Comma-separated list of origins allowed to call the API with credentials
# (CORS). Leave empty for same-origin-only use; set explicitly once a
# separate frontend origin exists (apps/web, Stage 10) or you're calling
# the API cross-origin from anywhere else.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=info

# Creates the first organisation + owner user via the bootstrap endpoint on
# first run (internal/modules/identity). Leave true for a fresh install;
# consider setting false after your org is created, since the bootstrap
# endpoint is meant for one-time initial setup, not ongoing use.
ENABLE_BOOTSTRAP=true

# Government e-Invoice integration (Stage 8) — leave as "mock" unless
# you're specifically testing against the NIC sandbox. Real production
# credentials do NOT belong in this file; see docs/operations/deployment.md.
EINVOICE_PROVIDER=mock

# --- only needed if you enable the optional `reverse-proxy` profile ---
HTTPS_PORT=443

# --- only needed if you enable the optional `minio` profile ---
MINIO_ROOT_USER=billing
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
